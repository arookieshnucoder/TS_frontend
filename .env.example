# Vite development server port. Restart Vite after changing.
VITE_PORT=5173

# Development proxy target; match backend PORT. Restart Vite after changing.
API_PROXY_TARGET=http://localhost:8080

# Browser API prefix. Production needs a reverse proxy for /api,
# or an absolute backend URL with matching backend FRONTEND_ORIGIN.
# 按照业务自己改名，后端也要跟着改
VITE_API_BASE_URL=/api
